# Copy to .env and adjust. NEVER commit the real .env.
# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In production set the real host(s), e.g.:
# DJANGO_ALLOWED_HOSTS=rozlicz-najem.pl,www.rozlicz-najem.pl
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rozlicz-najem.pl,https://www.rozlicz-najem.pl

# --- Database (PostgreSQL) ---
POSTGRES_DB=np
POSTGRES_USER=np
POSTGRES_PASSWORD=np-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Legacy MariaDB (one-off data migration only) ---
LEGACY_DB_HOST=legacydb
LEGACY_DB_PORT=3306
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=legacy
LEGACY_DB_NAME=np

# --- Email ---
# Backend defaults to console when DEBUG=True (emails printed to logs). Set
# EMAIL_BACKEND to the SMTP backend to actually send. Activation emails are sent
# asynchronously by the Celery worker.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#
# Local preview via Mailpit (docker compose): inbox at http://localhost:8025
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False
#
# Production example (Brevo SMTP relay; authenticate the domain in Brevo first):
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=xxxxxx@smtp-brevo.com
# EMAIL_HOST_PASSWORD=set-in-real-.env-only
# DEFAULT_FROM_EMAIL uses a human display name so it isn't a bare address:
# DEFAULT_FROM_EMAIL=Rozlicz Najem <no-reply@rozlicz-najem.pl>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Example App <noreply@example.com>
