# Copy to .env and adjust. NEVER commit the real .env.
# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
POSTGRES_DB=np
POSTGRES_USER=np
POSTGRES_PASSWORD=np-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Legacy MariaDB (one-off data migration only) ---
LEGACY_DB_HOST=legacydb
LEGACY_DB_PORT=3306
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=legacy
LEGACY_DB_NAME=np

# --- Email (dev uses console backend when DEBUG=True) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
